{
  "name": "dsh-plugin-mesh",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "插件生态图：把带 dsh 系列 GitHub 标签的仓库画成生态网络，含扇区图与 3D 星云两种模式。独立前端原型（非 DSH 插件）。",
  "scripts": {
    "serve": "node tools/serve.mjs",
    "serve:lan": "HOST=0.0.0.0 node tools/serve.mjs",
    "pretest": "npm run seed:fixture",
    "test": "npm run test:js && npm run test:py",
    "test:js": "node --test tests/*.test.mjs",
    "test:py": "python3 backend/tests/test_collector.py",
    "seed:fixture": "node tools/seed-fixture.mjs",
    "seed": "node tools/seed-sample.mjs",
    "precompute": "node tools/precompute-layout.mjs"
  },
  "engines": { "node": ">=22" }
}
